{
  "name": "vault-sweep",
  "version": "1.0.0",
  "description": "Clean and maintain your vault: find duplicate files, unused attachments, empty and orphan notes, broken links and large files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "vault",
    "cleanup",
    "maintenance"
  ],
  "author": "VaultSweep Contributors",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.5.1",
    "@typescript-eslint/parser": "^8.5.1",
    "esbuild": "^0.23.1",
    "eslint": "^9.11.1",
    "obsidian": "^1.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
